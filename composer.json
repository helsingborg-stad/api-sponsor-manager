{
    "name": "helsingborg-stad/api-sponsor-manager",
    "description": "Manages looking for sponsor listnings.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "scripts": {
        "test": "vendor/bin/phpunit --testsuite unit",
        "test:integration": "vendor/bin/phpunit --configuration phpunit-integration.xml",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --testsuite unit",
        "lint": "vendor/bin/mago lint",
        "fix": "vendor/bin/mago lint --format-after-fix --fix",
        "format": "vendor/bin/mago fmt"
    },
    "authors": [
        {
            "name": "Nikolas Ramsted",
            "email": "nikolas.ramstedt@helsingborg.se"
        }
    ],
    "autoload": {
        "psr-4": {
            "ApiSponsorManager\\": "source/php/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "helsingborg-stad/wputilservice": "^0.3",
        "helsingborg-stad/wpservice": "^2.0",
        "helsingborg-stad/acfservice": "^1.0"
    },
    "suggest": {
        "helsingborg-stad/municipio": "^6.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "carthage-software/mago": "1.8.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "wp-phpunit/wp-phpunit": "7.1.0",
        "johnpbloch/wordpress-core": "7.1.0",
        "yoast/phpunit-polyfills": "^4.0",
        "helsingborg-stad/acf-export-manager": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
